#!/usr/bin/env bash
# Blocks a commit when the leak check fails or the tool or skill tests are red.
# Enable once per clone: git config core.hooksPath tools/hooks
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
# why: Git for Windows runs this hook in its bash, where Python is often `python`, not `python3`, and `python3`
# may be the Microsoft Store placeholder that exists but only opens the Store: a candidate must really run.
PY3=
for cand in python3 python "$ROOT/.venv/bin/python" "$ROOT/.venv/Scripts/python.exe"; do
  if "$cand" -c "import sys" >/dev/null 2>&1; then PY3="$cand"; break; fi
done
if [ -z "$PY3" ]; then echo "pre-commit: no working Python (python3, python or the engine's .venv)"; exit 1; fi
# why: the staged content is what gets committed; the full scan also catches files staged earlier
"$PY3" "$ROOT/tools/check.py" --quiet --staged
"$PY3" "$ROOT/tools/check.py" --quiet
"$PY3" -m unittest discover -s "$ROOT/tools/tests" -q
# why: contract tools need python-docx and lxml, which live in the engine's .venv (install.sh / install.ps1);
# its Python is .venv/bin/python on Mac/Linux and .venv/Scripts/python.exe on Windows
PY="$PY3"
for venv in "$ROOT/.venv/bin/python" "$ROOT/.venv/Scripts/python.exe"; do
  if [ -x "$venv" ]; then PY="$venv"; break; fi
done
shopt -s nullglob  # why: no skill tests yet must not fail the hook
for tests in "$ROOT"/skills/*/tests; do
  [ -d "$tests" ] && "$PY" -m unittest discover -s "$tests" -q
done
