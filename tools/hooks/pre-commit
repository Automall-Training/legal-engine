#!/usr/bin/env bash
# Blocks a commit when the leak check fails or the tool or skill tests are red.
# Enable once per clone: git config core.hooksPath tools/hooks
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
python3 "$ROOT/tools/check.py" --quiet
python3 -m unittest discover -s "$ROOT/tools/tests" -q
# why: contract tools need python-docx and lxml, which live in the engine's .venv (./install.sh)
PY=python3
[ -x "$ROOT/.venv/bin/python" ] && PY="$ROOT/.venv/bin/python"
shopt -s nullglob  # why: no skill tests yet must not fail the hook
for tests in "$ROOT"/skills/*/tests; do
  [ -d "$tests" ] && "$PY" -m unittest discover -s "$tests" -q
done
